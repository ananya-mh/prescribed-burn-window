# Base URL of the FastAPI backend. No trailing slash.
# 127.0.0.1 rather than localhost: if anything is listening on IPv6 ::1:8000,
# "localhost" can resolve there instead of the backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" to skip the network and use src/mocks/burnWindow.json instead.
# Useful for working on the UI before the backend is running.
VITE_USE_MOCK=false
